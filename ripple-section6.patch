diff --git a/src/test/java/com/ripple/ArchitectureRulesTest.java b/src/test/java/com/ripple/ArchitectureRulesTest.java
new file mode 100644
index 0000000..217e4dd
--- /dev/null
+++ b/src/test/java/com/ripple/ArchitectureRulesTest.java
@@ -0,0 +1,109 @@
+package com.ripple;
+
+import org.junit.jupiter.api.Test;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Set;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/**
+ * Checks the project's ground rules by reading the source files (Phase 1, Section 6), so the
+ * MVC separation cannot be broken by accident later:
+ * <ul>
+ *   <li>a view never imports {@code java.sql} or a repository (this replaces the manual
+ *       {@code grep} from {@code PHASE1.md});</li>
+ *   <li>only views (and {@code Main}, which builds the window) use Swing or AWT;</li>
+ *   <li>only {@code Main} and the views refer to the view package;</li>
+ *   <li>every class has a Javadoc comment.</li>
+ * </ul>
+ */
+class ArchitectureRulesTest {
+
+    /** Packages that are allowed to use Swing / AWT. */
+    private static final Set<String> SWING_ALLOWED = Set.of("view", "app");
+    /** Packages that are allowed to refer to {@code com.ripple.view}. */
+    private static final Set<String> VIEW_ALLOWED = Set.of("view", "app");
+
+    private static final Pattern TYPE_DECLARATION = Pattern.compile(
+            "(?m)^(public\\s+|protected\\s+|private\\s+)?(static\\s+)?(final\\s+|abstract\\s+|sealed\\s+)*"
+                    + "(class|interface|enum|record)\\s+\\w+");
+
+    @Test
+    void viewsNeverUseTheDatabaseOrRepositories() throws IOException {
+        List<String> offenders = filesImporting(MainSources.inPackage("view"),
+                "java\\.sql|com\\.ripple\\.repository");
+
+        assertTrue(offenders.isEmpty(), "A view must call a controller instead of using the database: " + offenders);
+    }
+
+    @Test
+    void onlyViewsAndMainUseSwing() throws IOException {
+        List<Path> others = MainSources.all().stream()
+                .filter(source -> !SWING_ALLOWED.contains(MainSources.packageOf(source))).toList();
+
+        List<String> offenders = filesImporting(others, "javax\\.swing|java\\.awt");
+
+        assertTrue(offenders.isEmpty(), "Model, controller and pattern classes must not know about Swing: "
+                + offenders);
+    }
+
+    @Test
+    void onlyViewsAndMainReferToTheViewPackage() throws IOException {
+        List<Path> others = MainSources.all().stream()
+                .filter(source -> !VIEW_ALLOWED.contains(MainSources.packageOf(source))).toList();
+
+        List<String> offenders = filesImporting(others, "com\\.ripple\\.view");
+
+        assertTrue(offenders.isEmpty(), "Dependencies must point from view to controller to model, "
+                + "never back: " + offenders);
+    }
+
+    @Test
+    void everyClassHasAJavadocComment() throws IOException {
+        List<String> without = new ArrayList<>();
+        for (Path source : MainSources.all()) {
+            if (!hasJavadocOnTopLevelType(Files.readString(source, StandardCharsets.UTF_8))) {
+                without.add(MainSources.classNameOf(source));
+            }
+        }
+
+        assertTrue(without.isEmpty(), "Add a short Javadoc comment on top of: " + without);
+    }
+
+    /** The files (as class names) that have an {@code import} line matching the given regex. */
+    private static List<String> filesImporting(List<Path> sources, String importRegex) throws IOException {
+        Pattern importLine = Pattern.compile("(?m)^import\\s+(static\\s+)?(" + importRegex + ")");
+        List<String> offenders = new ArrayList<>();
+        for (Path source : sources) {
+            if (importLine.matcher(Files.readString(source, StandardCharsets.UTF_8)).find()) {
+                offenders.add(MainSources.classNameOf(source));
+            }
+        }
+        return offenders;
+    }
+
+    /** True if the comment right above the class / interface / enum / record declaration is a Javadoc. */
+    private static boolean hasJavadocOnTopLevelType(String source) {
+        Matcher declaration = TYPE_DECLARATION.matcher(source);
+        if (!declaration.find()) {
+            return false;
+        }
+        List<String> above = new ArrayList<>(List.of(source.substring(0, declaration.start()).split("\\R")));
+        // Annotations (e.g. @FunctionalInterface) may sit between the comment and the declaration.
+        while (!above.isEmpty() && (above.get(above.size() - 1).isBlank()
+                || above.get(above.size() - 1).strip().startsWith("@"))) {
+            above.remove(above.size() - 1);
+        }
+        String text = String.join("\n", above).strip();
+        // The comment that ends right above the declaration must itself start with "/**".
+        return text.endsWith("*/") && text.startsWith("/**", text.lastIndexOf("/*"));
+    }
+}
diff --git a/src/test/java/com/ripple/DiagramConsistencyTest.java b/src/test/java/com/ripple/DiagramConsistencyTest.java
new file mode 100644
index 0000000..4dd77a3
--- /dev/null
+++ b/src/test/java/com/ripple/DiagramConsistencyTest.java
@@ -0,0 +1,119 @@
+package com.ripple;
+
+import org.junit.jupiter.api.Test;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeMap;
+import java.util.TreeSet;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/**
+ * Fails the build if {@code docs/class-diagram.md} and the code drift apart (Phase 1, Section 6).
+ *
+ * <p>The "complete diagram" in section 2 of the document is the team contract, so:
+ * <ul>
+ *   <li>every class drawn in it must exist in the code;</li>
+ *   <li>every class in the code must be drawn in it;</li>
+ *   <li>each class must sit in the diagram namespace that matches its Java package;</li>
+ *   <li>the small per-pattern diagrams may only use classes of the complete diagram.</li>
+ * </ul>
+ * It compares class names and packages, not every field and method.
+ */
+class DiagramConsistencyTest {
+
+    private static final Path DIAGRAM = Path.of("docs", "class-diagram.md");
+    private static final Pattern CLASS_LINE = Pattern.compile("(?m)^\\s*class\\s+(\\w+)");
+    private static final Pattern NAMESPACE_BLOCK = Pattern.compile("(?ms)^namespace\\s+(\\w+)\\s*\\{(.*?)^\\}");
+    private static final Pattern MERMAID_BLOCK = Pattern.compile("(?s)```mermaid\\R(.*?)```");
+
+    @Test
+    void everyClassInTheDiagramExistsInTheCode() throws IOException {
+        Set<String> missing = new TreeSet<>(diagramClasses().keySet());
+        missing.removeAll(codeClasses().keySet());
+
+        assertTrue(missing.isEmpty(), "Drawn in docs/class-diagram.md but not found in src/main/java: " + missing
+                + ". Create the class, or remove it from the diagram.");
+    }
+
+    @Test
+    void everyClassInTheCodeIsInTheDiagram() throws IOException {
+        Set<String> undrawn = new TreeSet<>(codeClasses().keySet());
+        undrawn.removeAll(diagramClasses().keySet());
+
+        assertTrue(undrawn.isEmpty(), "In src/main/java but missing from the complete diagram in "
+                + "docs/class-diagram.md: " + undrawn + ". Add it to the diagram (and to the class tables).");
+    }
+
+    @Test
+    void eachClassIsDrawnInTheNamespaceOfItsPackage() throws IOException {
+        Map<String, String> inDiagram = diagramClasses();
+        List<String> wrong = new ArrayList<>();
+        codeClasses().forEach((name, packageName) -> {
+            String namespace = inDiagram.get(name);
+            if (namespace != null && !namespace.equals(packageName)) {
+                wrong.add(name + " is in package '" + packageName + "' but drawn in namespace '" + namespace + "'");
+            }
+        });
+
+        assertTrue(wrong.isEmpty(), "Namespace and package disagree: " + wrong);
+    }
+
+    @Test
+    void patternDiagramsOnlyUseClassesOfTheCompleteDiagram() throws IOException {
+        Set<String> known = diagramClasses().keySet();
+        Set<String> unknown = new TreeSet<>();
+        Matcher block = MERMAID_BLOCK.matcher(read());
+        while (block.find()) {
+            Matcher cls = CLASS_LINE.matcher(block.group(1));
+            while (cls.find()) {
+                if (!known.contains(cls.group(1))) {
+                    unknown.add(cls.group(1));
+                }
+            }
+        }
+
+        assertTrue(unknown.isEmpty(), "Used in a pattern diagram but not in the complete diagram: " + unknown);
+    }
+
+    /** Class name -> namespace, for every class in section 2 ("Complete diagram") of the document. */
+    private static Map<String, String> diagramClasses() throws IOException {
+        String markdown = read();
+        int start = markdown.indexOf("## 2. Complete diagram");
+        int end = markdown.indexOf("## 3.", start);
+        assertTrue(start >= 0 && end > start,
+                "docs/class-diagram.md must contain the headings '## 2. Complete diagram' and '## 3.'");
+
+        Map<String, String> classes = new TreeMap<>();
+        Matcher namespace = NAMESPACE_BLOCK.matcher(markdown.substring(start, end));
+        while (namespace.find()) {
+            Matcher cls = CLASS_LINE.matcher(namespace.group(2));
+            while (cls.find()) {
+                classes.put(cls.group(1), namespace.group(1));
+            }
+        }
+        return classes;
+    }
+
+    /** Class name -> package folder, for every Java file in {@code src/main/java}. */
+    private static Map<String, String> codeClasses() {
+        Map<String, String> classes = new TreeMap<>();
+        for (Path source : MainSources.all()) {
+            classes.put(MainSources.classNameOf(source), MainSources.packageOf(source));
+        }
+        return classes;
+    }
+
+    private static String read() throws IOException {
+        return Files.readString(DIAGRAM, StandardCharsets.UTF_8);
+    }
+}
diff --git a/src/test/java/com/ripple/MainSources.java b/src/test/java/com/ripple/MainSources.java
new file mode 100644
index 0000000..dbb3537
--- /dev/null
+++ b/src/test/java/com/ripple/MainSources.java
@@ -0,0 +1,75 @@
+package com.ripple;
+
+import java.io.IOException;
+import java.io.UncheckedIOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+import java.util.stream.Stream;
+
+/**
+ * Test helper: finds Ripple's own source files so tests can check the project's structure.
+ *
+ * <p>Maven runs tests from the project folder, so the paths below are relative to it.
+ */
+public final class MainSources {
+
+    /** The folder that holds {@code com/ripple/...}. */
+    public static final Path ROOT = Path.of("src", "main", "java", "com", "ripple");
+
+    private MainSources() {
+    }
+
+    /**
+     * Lists every {@code .java} file under one package folder of {@code com.ripple}.
+     *
+     * @param packageName the sub-package, e.g. {@code "view"}
+     * @return its source files, without {@code package-info.java}
+     */
+    public static List<Path> inPackage(String packageName) {
+        return list(ROOT.resolve(packageName));
+    }
+
+    /**
+     * Lists every {@code .java} file of Ripple, without {@code package-info.java}.
+     *
+     * @return all main source files
+     */
+    public static List<Path> all() {
+        return list(ROOT);
+    }
+
+    private static List<Path> list(Path folder) {
+        try (Stream<Path> files = Files.walk(folder)) {
+            return files.filter(path -> path.toString().endsWith(".java"))
+                    .filter(path -> !path.getFileName().toString().equals("package-info.java"))
+                    .sorted()
+                    .toList();
+        } catch (IOException e) {
+            throw new UncheckedIOException("Could not read " + folder.toAbsolutePath()
+                    + ". Run the tests from the project folder (mvn test).", e);
+        }
+    }
+
+    /**
+     * The package a source file belongs to, taken from its folder, e.g. {@code "view"} for
+     * {@code src/main/java/com/ripple/view/MainFrame.java}.
+     *
+     * @param source a file returned by {@link #all()}
+     * @return the name of the folder directly under {@code com/ripple}
+     */
+    public static String packageOf(Path source) {
+        return ROOT.relativize(source).getName(0).toString();
+    }
+
+    /**
+     * The class name of a source file, e.g. {@code "MainFrame"}.
+     *
+     * @param source a file returned by {@link #all()}
+     * @return the file name without {@code .java}
+     */
+    public static String classNameOf(Path source) {
+        String file = source.getFileName().toString();
+        return file.substring(0, file.length() - ".java".length());
+    }
+}
diff --git a/src/test/java/com/ripple/controller/DashboardControllerTest.java b/src/test/java/com/ripple/controller/DashboardControllerTest.java
new file mode 100644
index 0000000..a7834f5
--- /dev/null
+++ b/src/test/java/com/ripple/controller/DashboardControllerTest.java
@@ -0,0 +1,150 @@
+package com.ripple.controller;
+
+import com.ripple.TestDatabase;
+import com.ripple.factory.DonationFactory;
+import com.ripple.factory.DonationRequest;
+import com.ripple.logging.ApplicationLogger;
+import com.ripple.model.ContactChannel;
+import com.ripple.model.DonationMethod;
+import com.ripple.model.Donor;
+import com.ripple.repository.BeneficiaryRepository;
+import com.ripple.repository.Database;
+import com.ripple.repository.DonationRepository;
+import com.ripple.repository.DonationTypeRepository;
+import com.ripple.repository.DonorRepository;
+import com.ripple.repository.EventCategoryRepository;
+import com.ripple.repository.EventRepository;
+import com.ripple.repository.VolunteerRepository;
+import com.ripple.service.DonationService;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+import java.nio.file.Path;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/** Tests that the Dashboard's numbers follow the data and that its activity list comes from the logger. */
+class DashboardControllerTest {
+
+    @TempDir
+    Path tempDir;
+
+    private Database db;
+    private DashboardController dashboard;
+    private DonationService donationService;
+    private DonationTypeRepository donationTypes;
+    private VolunteerController volunteerController;
+    private EventController eventController;
+    private BeneficiaryController beneficiaryController;
+
+    @BeforeEach
+    void setUp() {
+        db = TestDatabase.create(tempDir);
+        DonationFactory factory = new DonationFactory();
+        DonorRepository donors = new DonorRepository(db);
+        DonationRepository donations = new DonationRepository(db, factory);
+        VolunteerRepository volunteers = new VolunteerRepository(db);
+        EventRepository events = new EventRepository(db);
+        BeneficiaryRepository beneficiaries = new BeneficiaryRepository(db);
+        donationTypes = new DonationTypeRepository(db);
+
+        dashboard = new DashboardController(donors, donations, volunteers, events, beneficiaries);
+        donationService = new DonationService(factory, donors, donations, donationTypes);
+        volunteerController = new VolunteerController(volunteers);
+        eventController = new EventController(events, volunteers);
+        beneficiaryController = new BeneficiaryController(beneficiaries);
+    }
+
+    @Test
+    void aFreshDatabaseShowsZeros() {
+        DashboardSummary summary = dashboard.getSummary();
+
+        assertEquals(0, summary.donors());
+        assertEquals(0, summary.donations());
+        assertEquals(0.0, summary.totalDonationValue(), 0.0001);
+        assertEquals(0, summary.volunteers());
+        assertEquals(0, summary.events());
+        assertEquals(0, summary.beneficiaries());
+    }
+
+    @Test
+    void numbersChangeAfterRecordingADonation() {
+        Donor donor = donationService.registerDonor("Mona Ali", "mona@example.com", "", ContactChannel.EMAIL);
+        int typeId = donationTypes.findAll().get(0).getId();
+        assertEquals(1, dashboard.getSummary().donors());
+        assertEquals(0, dashboard.getSummary().donations());
+
+        donationService.recordDonation(DonationMethod.CASH, donor.getId(), typeId,
+                new DonationRequest(100.0, null, null, 0, 0, null));
+        DashboardSummary afterOne = dashboard.getSummary();
+        assertEquals(1, afterOne.donations());
+        assertEquals(100.0, afterOne.totalDonationValue(), 0.0001);
+
+        donationService.recordDonation(DonationMethod.ONLINE, donor.getId(), typeId,
+                new DonationRequest(50.0, "TX-1", null, 0, 0, null));
+        donationService.recordDonation(DonationMethod.IN_KIND, donor.getId(), typeId,
+                new DonationRequest(0, null, "Blankets", 5, 25.0, null));
+        DashboardSummary afterThree = dashboard.getSummary();
+        assertEquals(3, afterThree.donations());
+        // 100 cash + 50 online + 25 estimated value of the in-kind gift
+        assertEquals(175.0, afterThree.totalDonationValue(), 0.0001);
+    }
+
+    @Test
+    void volunteerEventAndBeneficiaryCountsFollowTheirScreens() {
+        int categoryId = new EventCategoryRepository(db).findAll().get(0).getId();
+
+        assertTrue(volunteerController.saveVolunteer(null, "Omar Samy", "", "01198765432", "", "").success());
+        assertTrue(eventController.saveEvent(null, "Winter drive", categoryId, "2026-12-15", "Cairo", "")
+                .success());
+        assertTrue(beneficiaryController.saveBeneficiary(null, "Hoda Mahmoud", "", "01098765432", "", "")
+                .success());
+        assertTrue(beneficiaryController.saveBeneficiary(null, "Sara Adel", "", "01012345678", "", "")
+                .success());
+
+        DashboardSummary summary = dashboard.getSummary();
+        assertEquals(1, summary.volunteers());
+        assertEquals(1, summary.events());
+        assertEquals(2, summary.beneficiaries());
+    }
+
+    @Test
+    void recentActivityComesFromTheLoggerNewestFirstAndIsLimited() {
+        ApplicationLogger logger = ApplicationLogger.getInstance();
+        for (int i = 1; i <= DashboardController.RECENT_ACTIVITY_LIMIT + 5; i++) {
+            logger.info("dashboard test entry " + i);
+        }
+
+        var recent = dashboard.getSummary().recentActivity();
+
+        assertEquals(DashboardController.RECENT_ACTIVITY_LIMIT, recent.size());
+        assertTrue(recent.get(0).endsWith("dashboard test entry " + (DashboardController.RECENT_ACTIVITY_LIMIT + 5)),
+                recent.get(0));
+    }
+
+    @Test
+    void theActivityListCannotBeChangedByTheView() {
+        DashboardSummary summary = dashboard.getSummary();
+
+        assertThrows(UnsupportedOperationException.class, () -> summary.recentActivity().add("hack"));
+    }
+
+    @Test
+    void aDatabaseProblemGivesZerosAndAnExplanationInsteadOfAnException() {
+        // A database file that was never initialized has no tables, so every count fails.
+        Database broken = new Database(tempDir.resolve("broken.db").toString());
+        DashboardController brokenDashboard = new DashboardController(new DonorRepository(broken),
+                new DonationRepository(broken, new DonationFactory()), new VolunteerRepository(broken),
+                new EventRepository(broken), new BeneficiaryRepository(broken));
+
+        DashboardSummary summary = brokenDashboard.getSummary();
+
+        assertEquals(0, summary.donors());
+        assertEquals(0.0, summary.totalDonationValue(), 0.0001);
+        assertEquals(1, summary.recentActivity().size());
+        assertTrue(summary.recentActivity().get(0).contains("database error"), summary.recentActivity().get(0));
+    }
+}
