    "VolunteerRepository" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#d5dae2" CELLPADDING="5"><B>VolunteerRepository</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+findAll(): List&lt;Volunteer&gt;<BR ALIGN="LEFT"/>+insert(volunteer: Volunteer): Volunteer<BR ALIGN="LEFT"/>+update(volunteer: Volunteer): void<BR ALIGN="LEFT"/>+delete(id: int): void<BR ALIGN="LEFT"/>+count(): int<BR ALIGN="LEFT"/>+assignToEvent(volunteerId: int, eventId: int): void<BR ALIGN="LEFT"/>+findByEvent(eventId: int): List&lt;Volunteer&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "EventRepository" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#d5dae2" CELLPADDING="5"><B>EventRepository</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+findAll(): List&lt;Event&gt;<BR ALIGN="LEFT"/>+findById(id: int): Optional&lt;Event&gt;<BR ALIGN="LEFT"/>+insert(event: Event): Event<BR ALIGN="LEFT"/>+update(event: Event): void<BR ALIGN="LEFT"/>+delete(id: int): void<BR ALIGN="LEFT"/>+count(): int<BR ALIGN="LEFT"/>+addAttendee(attendee: Attendee): Attendee<BR ALIGN="LEFT"/>+findAttendees(eventId: int): List&lt;Attendee&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
