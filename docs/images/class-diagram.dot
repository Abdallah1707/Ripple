digraph Ripple {
  graph [rankdir=LR splines=true nodesep=0.3 ranksep=0.9 bgcolor="#fcfbf8" fontname="Helvetica"
         labelloc=t labeljust=l pad=0.5 newrank=true
         label=<<FONT POINT-SIZE="30"><B>Ripple — UML Class Diagram</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="16" COLOR="#6a7489">NGO Management System  ·  Phase 1  ·  MVC  ·  Strategy  ·  Observer  ·  Decorator  ·  Factory Method  ·  Singleton</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="12" COLOR="#6a7489">Arrows: hollow triangle = inheritance (dashed = implements) · open arrow = association · hollow diamond = aggregation (&gt;5 methods used) · filled diamond = composition · dashed open arrow = dependency. Dashed arrows into the shared helpers (ApplicationLogger, Result) are drawn once; docs/class-diagram.md lists them all.</FONT><BR ALIGN="LEFT"/> >];
  node [fontname="Helvetica" fontsize=11];
  edge [fontname="Helvetica" fontsize=9 fontcolor="#6a7489" penwidth=1.2];
  subgraph cluster_view {
    label=<<B>VIEW  |  MVC</B>> fontsize=15 fontcolor="#5d6570" labeljust=l
    style="rounded,filled" fillcolor="#eaf2ff" color="#cfe2fb" penwidth=2 margin=16
    "Refreshable" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#cfe2fb" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#55607a">«interface»</FONT><BR/><B><I>Refreshable</I></B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+refresh(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "StatusBar" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#cfe2fb" CELLPADDING="5"><B>StatusBar</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+showResult(result: Result): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "MainFrame" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#cfe2fb" CELLPADDING="5"><B>MainFrame</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+addScreen(name: String, screen: JPanel): void<BR ALIGN="LEFT"/>+getStatusBar(): StatusBar<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "DashboardPanel" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#cfe2fb" CELLPADDING="5"><B>DashboardPanel</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+refresh(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "DonationsPanel" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#cfe2fb" CELLPADDING="5"><B>DonationsPanel</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+refresh(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "VolunteersPanel" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#cfe2fb" CELLPADDING="5"><B>VolunteersPanel</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+refresh(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "EventsPanel" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#cfe2fb" CELLPADDING="5"><B>EventsPanel</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+refresh(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "BeneficiariesPanel" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#cfe2fb" CELLPADDING="5"><B>BeneficiariesPanel</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+refresh(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "CommunicationPanel" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#cfe2fb" CELLPADDING="5"><B>CommunicationPanel</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+refresh(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "LookupPanel" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#cfe2fb" CELLPADDING="5"><B>LookupPanel</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+refresh(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "LookupTablePanel" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#cfe2fb" CELLPADDING="5"><B>LookupTablePanel</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+refresh(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }
  subgraph cluster_controller {
    label=<<B>CONTROLLER  |  MVC</B>> fontsize=15 fontcolor="#5d6570" labeljust=l
    style="rounded,filled" fillcolor="#fff1e5" color="#fad9bc" penwidth=2 margin=16
    "Result" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#fad9bc" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#55607a">«record»</FONT><BR/><B>Result</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+success: boolean<BR ALIGN="LEFT"/>+message: String<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><U>+ok(message: String): Result</U><BR ALIGN="LEFT"/><U>+fail(message: String): Result</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "DashboardSummary" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#fad9bc" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#55607a">«record»</FONT><BR/><B>DashboardSummary</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+donors: int<BR ALIGN="LEFT"/>+donations: int<BR ALIGN="LEFT"/>+totalDonationValue: double<BR ALIGN="LEFT"/>+volunteers: int<BR ALIGN="LEFT"/>+events: int<BR ALIGN="LEFT"/>+beneficiaries: int<BR ALIGN="LEFT"/>+recentActivity: List&lt;String&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "LookupKind" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#fad9bc" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#55607a">«enumeration»</FONT><BR/><B>LookupKind</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">DONATION_TYPE<BR ALIGN="LEFT"/>EVENT_CATEGORY<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+getTitle(): String<BR ALIGN="LEFT"/>+hasTaxFlag(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "Audience" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#fad9bc" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#55607a">«enumeration»</FONT><BR/><B>Audience</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">DONORS<BR ALIGN="LEFT"/>VOLUNTEERS<BR ALIGN="LEFT"/>BENEFICIARIES<BR ALIGN="LEFT"/>EVENT_ATTENDEES<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+getLabel(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "LookupController" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#fad9bc" CELLPADDING="5"><B>LookupController</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+list(kind: LookupKind): List&lt;LookupEntry&gt;<BR ALIGN="LEFT"/>+listDonationTypes(): List&lt;DonationType&gt;<BR ALIGN="LEFT"/>+listEventCategories(): List&lt;EventCategory&gt;<BR ALIGN="LEFT"/>+save(kind: LookupKind, id: Integer, name: String, description: String, taxDeductible: boolean): Result<BR ALIGN="LEFT"/>+delete(kind: LookupKind, id: int): Result<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "DonationController" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#fad9bc" CELLPADDING="5"><B>DonationController</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+listDonors(): List&lt;Donor&gt;<BR ALIGN="LEFT"/>+saveDonor(id: Integer, name: String, email: String, phone: String, socialHandle: String, channel: String): Result<BR ALIGN="LEFT"/>+deleteDonor(id: int): Result<BR ALIGN="LEFT"/>+recordDonation(donorId: int, typeId: int, method: String, amount: String, transactionRef: String, item: String, quantity: String, estimatedValue: String): Result<BR ALIGN="LEFT"/>+listDonations(): List&lt;Donation&gt;<BR ALIGN="LEFT"/>+getReceipt(donationId: int): String<BR ALIGN="LEFT"/>+setDonorNotifications(enabled: boolean): void<BR ALIGN="LEFT"/>+isDonorNotificationsEnabled(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "VolunteerController" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#fad9bc" CELLPADDING="5"><B>VolunteerController</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+listVolunteers(): List&lt;Volunteer&gt;<BR ALIGN="LEFT"/>+saveVolunteer(id: Integer, name: String, email: String, phone: String, skills: String, availability: String): Result<BR ALIGN="LEFT"/>+deleteVolunteer(id: int): Result<BR ALIGN="LEFT"/>+assignToEvent(volunteerId: int, eventId: int): Result<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "EventController" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#fad9bc" CELLPADDING="5"><B>EventController</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+listEvents(): List&lt;Event&gt;<BR ALIGN="LEFT"/>+saveEvent(id: Integer, name: String, categoryId: int, date: String, location: String, description: String): Result<BR ALIGN="LEFT"/>+deleteEvent(id: int): Result<BR ALIGN="LEFT"/>+registerAttendee(eventId: int, name: String, email: String, phone: String): Result<BR ALIGN="LEFT"/>+listAttendees(eventId: int): List&lt;Attendee&gt;<BR ALIGN="LEFT"/>+listVolunteers(eventId: int): List&lt;Volunteer&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "BeneficiaryController" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#fad9bc" CELLPADDING="5"><B>BeneficiaryController</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+listBeneficiaries(): List&lt;Beneficiary&gt;<BR ALIGN="LEFT"/>+saveBeneficiary(id: Integer, name: String, email: String, phone: String, address: String, needs: String): Result<BR ALIGN="LEFT"/>+deleteBeneficiary(id: int): Result<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "CommunicationController" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#fad9bc" CELLPADDING="5"><B>CommunicationController</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+sendToGroup(audience: Audience, eventId: Integer, channel: String, subject: String, body: String): Result<BR ALIGN="LEFT"/>+listMessageLog(): List&lt;MessageLogEntry&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "DashboardController" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#fad9bc" CELLPADDING="5"><B>DashboardController</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+getSummary(): DashboardSummary<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }
  subgraph cluster_service {
    label=<<B>SERVICE  |  MVC MODEL  ·  OBSERVER SUBJECTS</B>> fontsize=15 fontcolor="#5d6570" labeljust=l
    style="rounded,filled" fillcolor="#f3e9fa" color="#e3cdf2" penwidth=2 margin=16
    "LookupService" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#e3cdf2" CELLPADDING="5"><B>LookupService&lt;T&gt;</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">-entityLabel: String<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+findAll(): List&lt;T&gt;<BR ALIGN="LEFT"/>+add(entry: T): T<BR ALIGN="LEFT"/>+update(entry: T): void<BR ALIGN="LEFT"/>+delete(id: int): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "DonationService" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#e3cdf2" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#55607a">«Subject»</FONT><BR/><B>DonationService</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">-observers: List&lt;DonationObserver&gt;<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+registerObserver(observer: DonationObserver): void<BR ALIGN="LEFT"/>+removeObserver(observer: DonationObserver): void<BR ALIGN="LEFT"/>+notifyObservers(donation: Donation): void<BR ALIGN="LEFT"/>+isRegistered(observer: DonationObserver): boolean<BR ALIGN="LEFT"/>+registerDonor(name: String, email: String, phone: String, socialHandle: String, channel: ContactChannel): Donor<BR ALIGN="LEFT"/>+updateDonor(id: int, name: String, email: String, phone: String, socialHandle: String, channel: ContactChannel): Donor<BR ALIGN="LEFT"/>+deleteDonor(id: int): Donor<BR ALIGN="LEFT"/>+findAllDonors(): List&lt;Donor&gt;<BR ALIGN="LEFT"/>+recordDonation(method: DonationMethod, donorId: int, donationTypeId: int, request: DonationRequest): Donation<BR ALIGN="LEFT"/>+findAllDonations(): List&lt;Donation&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "EventService" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#e3cdf2" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#55607a">«Subject»</FONT><BR/><B>EventService</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">-observers: List&lt;EventObserver&gt;<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+registerObserver(observer: EventObserver): void<BR ALIGN="LEFT"/>+removeObserver(observer: EventObserver): void<BR ALIGN="LEFT"/>+notifyObservers(event: Event, change: String): void<BR ALIGN="LEFT"/>+isRegistered(observer: EventObserver): boolean<BR ALIGN="LEFT"/>+addEvent(event: Event): Event<BR ALIGN="LEFT"/>+updateEvent(event: Event): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }
  subgraph cluster_observer {
    label=<<B>OBSERVER  |  OBSERVER</B>> fontsize=15 fontcolor="#5d6570" labeljust=l
    style="rounded,filled" fillcolor="#fff8dc" color="#f7e7a6" penwidth=2 margin=16
    "DonationSubject" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#f7e7a6" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#55607a">«interface»</FONT><BR/><B><I>DonationSubject</I></B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+registerObserver(observer: DonationObserver): void<BR ALIGN="LEFT"/>+removeObserver(observer: DonationObserver): void<BR ALIGN="LEFT"/>+notifyObservers(donation: Donation): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "DonationObserver" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#f7e7a6" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#55607a">«interface»</FONT><BR/><B><I>DonationObserver</I></B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+update(donation: Donation): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "DonationLogObserver" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#f7e7a6" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#55607a">«Observer»</FONT><BR/><B>DonationLogObserver</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+update(donation: Donation): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "ReceiptObserver" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#f7e7a6" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#55607a">«Observer»</FONT><BR/><B>ReceiptObserver</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+update(donation: Donation): void<BR ALIGN="LEFT"/>+buildReceipt(donation: Donation): Receipt<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "DonorNotificationObserver" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#f7e7a6" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#55607a">«Observer»</FONT><BR/><B>DonorNotificationObserver</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+update(donation: Donation): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "EventSubject" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#f7e7a6" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#55607a">«interface»</FONT><BR/><B><I>EventSubject</I></B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+registerObserver(observer: EventObserver): void<BR ALIGN="LEFT"/>+removeObserver(observer: EventObserver): void<BR ALIGN="LEFT"/>+notifyObservers(event: Event, change: String): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "EventObserver" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#f7e7a6" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#55607a">«interface»</FONT><BR/><B><I>EventObserver</I></B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+update(event: Event, change: String): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "AttendeeNotificationObserver" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#f7e7a6" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#55607a">«Observer»</FONT><BR/><B>AttendeeNotificationObserver</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+update(event: Event, change: String): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }
  subgraph cluster_factory {
    label=<<B>FACTORY  |  FACTORY METHOD</B>> fontsize=15 fontcolor="#5d6570" labeljust=l
    style="rounded,filled" fillcolor="#f1ecfb" color="#dcd1f4" penwidth=2 margin=16
    "DonationFactory" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#dcd1f4" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#55607a">«abstract»</FONT><BR/><B><I>DonationFactory</I></B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+orderDonation(donor: Donor, type: DonationType, request: DonationRequest): Donation<BR ALIGN="LEFT"/><I>#createDonation(donor: Donor, type: DonationType, request: DonationRequest, createdAt: LocalDateTime): Donation</I><BR ALIGN="LEFT"/><I>+getMethod(): DonationMethod</I><BR ALIGN="LEFT"/><U>#requirePositiveAmount(amount: double): void</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "CashDonationFactory" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#dcd1f4" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#55607a">«ConcreteCreator»</FONT><BR/><B>CashDonationFactory</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">#createDonation(donor: Donor, type: DonationType, request: DonationRequest, createdAt: LocalDateTime): Donation<BR ALIGN="LEFT"/>+getMethod(): DonationMethod<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "OnlineDonationFactory" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#dcd1f4" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#55607a">«ConcreteCreator»</FONT><BR/><B>OnlineDonationFactory</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">#createDonation(donor: Donor, type: DonationType, request: DonationRequest, createdAt: LocalDateTime): Donation<BR ALIGN="LEFT"/>+getMethod(): DonationMethod<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "InKindDonationFactory" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#dcd1f4" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#55607a">«ConcreteCreator»</FONT><BR/><B>InKindDonationFactory</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">#createDonation(donor: Donor, type: DonationType, request: DonationRequest, createdAt: LocalDateTime): Donation<BR ALIGN="LEFT"/>+getMethod(): DonationMethod<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "ChequeDonationFactory" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#dcd1f4" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#55607a">«ConcreteCreator»</FONT><BR/><B>ChequeDonationFactory</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">#createDonation(donor: Donor, type: DonationType, request: DonationRequest, createdAt: LocalDateTime): Donation<BR ALIGN="LEFT"/>+getMethod(): DonationMethod<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "DonationRequest" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#dcd1f4" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#55607a">«record»</FONT><BR/><B>DonationRequest</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+amount: double<BR ALIGN="LEFT"/>+transactionReference: String<BR ALIGN="LEFT"/>+itemDescription: String<BR ALIGN="LEFT"/>+quantity: int<BR ALIGN="LEFT"/>+estimatedValue: double<BR ALIGN="LEFT"/>+createdAt: LocalDateTime<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }
  subgraph cluster_communication {
    label=<<B>COMMUNICATION  |  STRATEGY</B>> fontsize=15 fontcolor="#5d6570" labeljust=l
    style="rounded,filled" fillcolor="#e6f6fa" color="#bde5f0" penwidth=2 margin=16
    "CommunicationStrategy" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#bde5f0" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#55607a">«interface»</FONT><BR/><B><I>CommunicationStrategy</I></B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+getChannel(): ContactChannel<BR ALIGN="LEFT"/>+addressOf(recipient: Contactable): String<BR ALIGN="LEFT"/>+isValidAddress(address: String): boolean<BR ALIGN="LEFT"/>+send(message: Message): DeliveryResult<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "EmailStrategy" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#bde5f0" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#55607a">«Strategy»</FONT><BR/><B>EmailStrategy</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+getChannel(): ContactChannel<BR ALIGN="LEFT"/>+addressOf(recipient: Contactable): String<BR ALIGN="LEFT"/>+isValidAddress(address: String): boolean<BR ALIGN="LEFT"/>+send(message: Message): DeliveryResult<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "SmsStrategy" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#bde5f0" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#55607a">«Strategy»</FONT><BR/><B>SmsStrategy</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><U>+MAX_LENGTH: int</U><BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+getChannel(): ContactChannel<BR ALIGN="LEFT"/>+addressOf(recipient: Contactable): String<BR ALIGN="LEFT"/>+isValidAddress(address: String): boolean<BR ALIGN="LEFT"/>+send(message: Message): DeliveryResult<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "SocialMediaStrategy" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#bde5f0" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#55607a">«Strategy»</FONT><BR/><B>SocialMediaStrategy</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><U>+MAX_LENGTH: int</U><BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+getChannel(): ContactChannel<BR ALIGN="LEFT"/>+addressOf(recipient: Contactable): String<BR ALIGN="LEFT"/>+isValidAddress(address: String): boolean<BR ALIGN="LEFT"/>+send(message: Message): DeliveryResult<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "CommunicationService" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#bde5f0" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#55607a">«Context»</FONT><BR/><B>CommunicationService</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">-strategy: CommunicationStrategy<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+setStrategy(strategy: CommunicationStrategy): void<BR ALIGN="LEFT"/>+getStrategy(): CommunicationStrategy<BR ALIGN="LEFT"/>+send(recipient: Contactable, subject: String, body: String): DeliveryResult<BR ALIGN="LEFT"/>+sendToAll(recipients: List&lt;? extends Contactable&gt;, subject: String, body: String): List&lt;DeliveryResult&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "Message" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#bde5f0" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#55607a">«record»</FONT><BR/><B>Message</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+recipientName: String<BR ALIGN="LEFT"/>+address: String<BR ALIGN="LEFT"/>+subject: String<BR ALIGN="LEFT"/>+body: String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "DeliveryResult" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#bde5f0" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#55607a">«record»</FONT><BR/><B>DeliveryResult</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+success: boolean<BR ALIGN="LEFT"/>+status: String<BR ALIGN="LEFT"/>+detail: String<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><U>+simulated(detail: String): DeliveryResult</U><BR ALIGN="LEFT"/><U>+failed(detail: String): DeliveryResult</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "MessageLogEntry" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#bde5f0" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#55607a">«record»</FONT><BR/><B>MessageLogEntry</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+id: int<BR ALIGN="LEFT"/>+channel: ContactChannel<BR ALIGN="LEFT"/>+recipient: String<BR ALIGN="LEFT"/>+subject: String<BR ALIGN="LEFT"/>+body: String<BR ALIGN="LEFT"/>+status: String<BR ALIGN="LEFT"/>+sentAt: LocalDateTime<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }
  subgraph cluster_receipt {
    label=<<B>RECEIPT  |  DECORATOR</B>> fontsize=15 fontcolor="#5d6570" labeljust=l
    style="rounded,filled" fillcolor="#fdebef" color="#f7c6d0" penwidth=2 margin=16
    "Receipt" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#f7c6d0" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#55607a">«interface»</FONT><BR/><B><I>Receipt</I></B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+render(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "BasicReceipt" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#f7c6d0" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#55607a">«Component»</FONT><BR/><B>BasicReceipt</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">-donation: Donation<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+render(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "ReceiptDecorator" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#f7c6d0" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#55607a">«abstract»</FONT><BR/><B><I>ReceiptDecorator</I></B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">#wrapped: Receipt<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">#ReceiptDecorator(wrapped: Receipt)<BR ALIGN="LEFT"/>+render(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "ThankYouMessageDecorator" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#f7c6d0" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#55607a">«Decorator»</FONT><BR/><B>ThankYouMessageDecorator</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">-donorName: String<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+render(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "TaxInformationDecorator" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#f7c6d0" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#55607a">«Decorator»</FONT><BR/><B>TaxInformationDecorator</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">-donation: Donation<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+render(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }
  subgraph cluster_model {
    label=<<B>MODEL  |  ENTITIES  ·  FACTORY PRODUCTS</B>> fontsize=15 fontcolor="#5d6570" labeljust=l
    style="rounded,filled" fillcolor="#e7f7ed" color="#bce6cb" penwidth=2 margin=16
    "Contactable" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#bce6cb" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#55607a">«interface»</FONT><BR/><B><I>Contactable</I></B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+getName(): String<BR ALIGN="LEFT"/>+getEmail(): String<BR ALIGN="LEFT"/>+getPhone(): String<BR ALIGN="LEFT"/>+getSocialHandle(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "Person" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#bce6cb" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#55607a">«abstract»</FONT><BR/><B><I>Person</I></B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">-id: int<BR ALIGN="LEFT"/>-name: String<BR ALIGN="LEFT"/>-email: String<BR ALIGN="LEFT"/>-phone: String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "ContactChannel" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#bce6cb" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#55607a">«enumeration»</FONT><BR/><B>ContactChannel</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">EMAIL<BR ALIGN="LEFT"/>SMS<BR ALIGN="LEFT"/>SOCIAL<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+getAddressLabel(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "DonationMethod" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#bce6cb" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#55607a">«enumeration»</FONT><BR/><B>DonationMethod</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">CASH<BR ALIGN="LEFT"/>ONLINE<BR ALIGN="LEFT"/>IN_KIND<BR ALIGN="LEFT"/>CHEQUE<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+getLabel(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "Donor" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#bce6cb" CELLPADDING="5"><B>Donor</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">-socialHandle: String<BR ALIGN="LEFT"/>-preferredChannel: ContactChannel<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+getSocialHandle(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "Donation" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#bce6cb" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#55607a">«abstract»</FONT><BR/><B><I>Donation</I></B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">-id: int<BR ALIGN="LEFT"/>-donor: Donor<BR ALIGN="LEFT"/>-donationType: DonationType<BR ALIGN="LEFT"/>-createdAt: LocalDateTime<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><I>+getMethod(): DonationMethod</I><BR ALIGN="LEFT"/><I>+getValue(): double</I><BR ALIGN="LEFT"/><I>+describe(): String</I><BR ALIGN="LEFT"/>+getReceiptNumber(): String<BR ALIGN="LEFT"/>+isTaxDeductible(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "CashDonation" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#bce6cb" CELLPADDING="5"><B>CashDonation</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">-amount: double<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+getMethod(): DonationMethod<BR ALIGN="LEFT"/>+getValue(): double<BR ALIGN="LEFT"/>+describe(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "OnlineDonation" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#bce6cb" CELLPADDING="5"><B>OnlineDonation</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">-amount: double<BR ALIGN="LEFT"/>-transactionReference: String<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+getMethod(): DonationMethod<BR ALIGN="LEFT"/>+getValue(): double<BR ALIGN="LEFT"/>+describe(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "InKindDonation" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#bce6cb" CELLPADDING="5"><B>InKindDonation</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">-itemDescription: String<BR ALIGN="LEFT"/>-quantity: int<BR ALIGN="LEFT"/>-estimatedValue: double<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+getMethod(): DonationMethod<BR ALIGN="LEFT"/>+getValue(): double<BR ALIGN="LEFT"/>+describe(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "ChequeDonation" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#bce6cb" CELLPADDING="5"><B>ChequeDonation</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">-amount: double<BR ALIGN="LEFT"/>-chequeNumber: String<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+getMethod(): DonationMethod<BR ALIGN="LEFT"/>+getValue(): double<BR ALIGN="LEFT"/>+describe(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "LookupEntry" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#bce6cb" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#55607a">«abstract»</FONT><BR/><B><I>LookupEntry</I></B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">-id: int<BR ALIGN="LEFT"/>-name: String<BR ALIGN="LEFT"/>-description: String<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+toString(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "DonationType" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#bce6cb" CELLPADDING="5"><B>DonationType</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">-taxDeductible: boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "EventCategory" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#bce6cb" CELLPADDING="5"><B>EventCategory</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+EventCategory(id: int, name: String, description: String)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "Volunteer" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#bce6cb" CELLPADDING="5"><B>Volunteer</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">-skills: String<BR ALIGN="LEFT"/>-availability: String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "Event" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#bce6cb" CELLPADDING="5"><B>Event</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">-id: int<BR ALIGN="LEFT"/>-name: String<BR ALIGN="LEFT"/>-category: EventCategory<BR ALIGN="LEFT"/>-eventDate: LocalDate<BR ALIGN="LEFT"/>-location: String<BR ALIGN="LEFT"/>-description: String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "Attendee" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#bce6cb" CELLPADDING="5"><B>Attendee</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">-eventId: int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "Beneficiary" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#bce6cb" CELLPADDING="5"><B>Beneficiary</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">-address: String<BR ALIGN="LEFT"/>-needs: String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }
  subgraph cluster_repository {
    label=<<B>REPOSITORY  |  PERSISTENCE</B>> fontsize=15 fontcolor="#5d6570" labeljust=l
    style="rounded,filled" fillcolor="#f0f2f5" color="#d5dae2" penwidth=2 margin=16
    "Database" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#d5dae2" CELLPADDING="5"><B>Database</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><U>+DEFAULT_PATH: String</U><BR ALIGN="LEFT"/>-url: String<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><U>+fromEnvironment(): Database</U><BR ALIGN="LEFT"/>+getConnection(): Connection<BR ALIGN="LEFT"/>+initialize(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "LookupRepository" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#d5dae2" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#55607a">«interface»</FONT><BR/><B><I>LookupRepository&lt;T&gt;</I></B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+findAll(): List&lt;T&gt;<BR ALIGN="LEFT"/>+findById(id: int): Optional&lt;T&gt;<BR ALIGN="LEFT"/>+existsByName(name: String, excludeId: int): boolean<BR ALIGN="LEFT"/>+insert(entry: T): T<BR ALIGN="LEFT"/>+update(entry: T): void<BR ALIGN="LEFT"/>+delete(id: int): void<BR ALIGN="LEFT"/>+countUsages(id: int): int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "DonationTypeRepository" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#d5dae2" CELLPADDING="5"><B>DonationTypeRepository</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+countUsages(id: int): int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "EventCategoryRepository" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#d5dae2" CELLPADDING="5"><B>EventCategoryRepository</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+countUsages(id: int): int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "DonorRepository" [shape=plain label=<<TABLE BORDER="1" COLOR="#9aa6b8" STYLE="ROUNDED" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#d5dae2" CELLPADDING="5"><B>DonorRepository</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+findAll(): List&lt;Donor&gt;<BR ALIGN="LEFT"/>+findById(id: int): Optional&lt;Donor&gt;<BR ALIGN="LEFT"/>+insert(donor: Donor): Donor<BR ALIGN="LEFT"/>+update(donor: Donor): void<BR ALIGN="LEFT"/>+delete(id: int): void<BR ALIGN="LEFT"/>+countDonations(donorId: int): int<BR ALIGN="LEFT"/>+count(): int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
